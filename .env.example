# Copy to .env before running `docker compose up`. Compose reads .env from
# this directory automatically — never commit the real .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:2006,http://localhost:3030
HOST_PORT=2006
PUBLIC_HOST_PORT=2020
DEV_PORT=3030
PORT=4001
CORS_ORIGIN=http://localhost:3030,http://localhost:2006
# Optional host-only PostgreSQL port for local development tools.
POSTGRES_HOST_PORT=5432

# Leave unset/false only for localhost or a trusted private LAN over HTTP.
# Set to "true" when this app is actually
# served over HTTPS (a reverse proxy, a Cloudflare Tunnel, etc.) — the
# session cookie is marked Secure when this is true, and browsers silently
# refuse to store a Secure cookie on a plain http:// origin, which locks
# every user out with "Unauthorized" even though login appears to succeed.
COOKIE_SECURE=false

# Optional: makes THIS server a sync hub that Windows/desktop installs can
# two-way sync with (Settings → Server Sync on the other PC). Use a long random
# value (openssl rand -hex 24) and leave unset on installs that are not the hub.
# SYNC_API_KEY=

# Supabase migration target. The current application still uses the local
# PostgreSQL/NestJS stack; these values are introduced as the documented target
# and become active during the Supabase migration phase. Never expose the
# service-role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=
# For local PostgreSQL, set DATABASE_URL instead. `pnpm dev` uses
# SUPABASE_DATABASE_URL for the current Prisma backend when it is provided.
DATABASE_URL=

# Optional public restaurant ordering token used by the landing page CTA.
NEXT_PUBLIC_PUBLIC_ORDER_TOKEN=
# Optional customer storefront origin. Defaults to the current hostname on port 2020.
NEXT_PUBLIC_PUBLIC_STOREFRONT_ORIGIN=
# Optional branch public token. Set this so http://localhost:2020 opens the store directly.
STOREFRONT_DEFAULT_TOKEN=
